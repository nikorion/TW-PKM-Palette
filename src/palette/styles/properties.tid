title: $:/plugins/nikorion/palette/styles/properties
tags: $:/tags/Stylesheet
type: text/vnd.tiddlywiki

\rules except dash

<!-- CSS variables for the keys of the current palette that the core does not know
     (the core emits --tpc-<key> for the Vanilla keys only): --tpc-nk-site-title… -->
:root {
<$list filter="[{$:/palette}indexes[]] -[[$:/palettes/Vanilla]indexes[]]" variable="key">
	--tpc-<<key>>: <$transclude $variable="colour" $mode="inline" name=<<key>>/>;
</$list>
}
